{
  "name": "public-api",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate:mariadb": "node -r ts-node/register src/migrations/mariadb-to-dynamodb.ts",
    "migrate:mariadb:write": "node -r ts-node/register src/migrations/mariadb-to-dynamodb.ts --write",
    "start:local": "node -r ts-node/register src/local/start.ts",
    "test": "jest --config jest.config.cjs",
    "test:integration": "RUN_FLOCI_INTEGRATION=1 jest --config jest.config.cjs --runTestsByPath src/local/public-api.floci.integration.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@misneach/public-flows": "file:../../packages/public-flows",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
