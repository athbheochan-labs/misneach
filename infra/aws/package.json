{
  "name": "@decyphr/aws-infra",
  "version": "0.0.1",
  "private": true,
  "description": "AWS CDK infrastructure for Decyphr and Misneach public flows.",
  "type": "commonjs",
  "bin": {
    "decyphr-aws-infra": "bin/decyphr-public.ts"
  },
  "scripts": {
    "precdk": "npm run build --workspace @misneach/public-flows",
    "build": "tsc --noEmit",
    "cdk": "cdk",
    "synth": "npm run precdk && cdk synth",
    "diff": "npm run precdk && cdk diff",
    "deploy": "npm run precdk && cdk deploy",
    "bootstrap": "cdk bootstrap",
    "floci:bootstrap": "node ../../scripts/floci/cdk.mjs bootstrap aws://000000000000/eu-west-1",
    "floci:synth": "node ../../scripts/floci/cdk.mjs synth",
    "floci:deploy": "node ../../scripts/floci/cdk.mjs deploy --require-approval never"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.204.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "aws-cdk": "^2.1029.2",
    "esbuild": "^0.25.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
