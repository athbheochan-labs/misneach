FROM node:22.13.1 AS build
WORKDIR /usr/src/app

COPY package*.json ./
COPY tsconfig.base.json ./
COPY apps ./apps
COPY libs ./libs

RUN npm ci

RUN npm run build --workspace @decyphr/messaging \
    && npm run build --workspace translation-connector \
    && npm run build --workspace lexicon \
    && npm run build --workspace phrasebook \
    && npm run build --workspace flashcards \
    && npm run build --workspace focus \
    && npm run build --workspace practice \
    && npm run build --workspace courses \
    && npm run build --workspace challenges \
    && npm run build --workspace payment \
    && npm run build --workspace discounts \
    && npm run build --workspace business \
    && npm run build --workspace waitlist \
    && npm run build --workspace client

RUN npm prune --omit=dev --workspaces --include-workspace-root

FROM node:22.13.1-slim AS runtime
WORKDIR /usr/src/app
ENV NODE_ENV=production

COPY --from=build /usr/src/app/package*.json ./
COPY --from=build /usr/src/app/node_modules ./node_modules

COPY --from=build /usr/src/app/libs/messaging/package.json ./libs/messaging/package.json
COPY --from=build /usr/src/app/libs/messaging/dist ./libs/messaging/dist

COPY --from=build /usr/src/app/apps/translation/translation-connector/package.json ./apps/translation/translation-connector/package.json
COPY --from=build /usr/src/app/apps/translation/translation-connector/dist ./apps/translation/translation-connector/dist

COPY --from=build /usr/src/app/apps/lexicon/package.json ./apps/lexicon/package.json
COPY --from=build /usr/src/app/apps/lexicon/dist ./apps/lexicon/dist
COPY --from=build /usr/src/app/apps/lexicon/entrypoint.sh ./apps/lexicon/entrypoint.sh

COPY --from=build /usr/src/app/apps/phrasebook/package.json ./apps/phrasebook/package.json
COPY --from=build /usr/src/app/apps/phrasebook/dist ./apps/phrasebook/dist
COPY --from=build /usr/src/app/apps/phrasebook/entrypoint.sh ./apps/phrasebook/entrypoint.sh

COPY --from=build /usr/src/app/apps/flashcards/package.json ./apps/flashcards/package.json
COPY --from=build /usr/src/app/apps/flashcards/dist ./apps/flashcards/dist
COPY --from=build /usr/src/app/apps/flashcards/entrypoint.sh ./apps/flashcards/entrypoint.sh

COPY --from=build /usr/src/app/apps/focus/package.json ./apps/focus/package.json
COPY --from=build /usr/src/app/apps/focus/dist ./apps/focus/dist

COPY --from=build /usr/src/app/apps/practice/package.json ./apps/practice/package.json
COPY --from=build /usr/src/app/apps/practice/dist ./apps/practice/dist
COPY --from=build /usr/src/app/apps/practice/entrypoint.sh ./apps/practice/entrypoint.sh

COPY --from=build /usr/src/app/apps/courses/package.json ./apps/courses/package.json
COPY --from=build /usr/src/app/apps/courses/dist ./apps/courses/dist
COPY --from=build /usr/src/app/apps/courses/entrypoint.sh ./apps/courses/entrypoint.sh
COPY --from=build /usr/src/app/apps/courses/src/content ./apps/courses/src/content

COPY --from=build /usr/src/app/apps/challenges/package.json ./apps/challenges/package.json
COPY --from=build /usr/src/app/apps/challenges/dist ./apps/challenges/dist

COPY --from=build /usr/src/app/apps/payment/package.json ./apps/payment/package.json
COPY --from=build /usr/src/app/apps/payment/dist ./apps/payment/dist

COPY --from=build /usr/src/app/apps/discounts/package.json ./apps/discounts/package.json
COPY --from=build /usr/src/app/apps/discounts/dist ./apps/discounts/dist

COPY --from=build /usr/src/app/apps/business/package.json ./apps/business/package.json
COPY --from=build /usr/src/app/apps/business/dist ./apps/business/dist

COPY --from=build /usr/src/app/apps/waitlist/package.json ./apps/waitlist/package.json
COPY --from=build /usr/src/app/apps/waitlist/dist ./apps/waitlist/dist

COPY --from=build /usr/src/app/apps/client/package.json ./apps/client/package.json
COPY --from=build /usr/src/app/apps/client/dist ./apps/client/dist
COPY --from=build /usr/src/app/apps/client/node_modules ./apps/client/node_modules

RUN chmod +x /usr/src/app/apps/lexicon/entrypoint.sh \
    && chmod +x /usr/src/app/apps/phrasebook/entrypoint.sh \
    && chmod +x /usr/src/app/apps/flashcards/entrypoint.sh \
    && chmod +x /usr/src/app/apps/practice/entrypoint.sh \
    && chmod +x /usr/src/app/apps/courses/entrypoint.sh
