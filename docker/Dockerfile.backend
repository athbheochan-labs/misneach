FROM node:22.13.1 AS build
WORKDIR /usr/src/app

COPY package*.json ./
COPY tsconfig.base.json ./
COPY apps ./apps
COPY services ./services
COPY libs ./libs
COPY packages ./packages

RUN npm ci

RUN npm run build --workspace @decyphr/messaging \
    && npm run build --workspace @misneach/public-flows \
    && npm run build --workspace translation-connector \
    && npm run build --workspace lexicon \
    && npm run build --workspace phrasebook \
    && npm run build --workspace flashcards \
    && npm run build --workspace focus \
    && npm run build --workspace practice \
    && npm run build --workspace courses \
    && npm run build --workspace challenges \
    && npm run build --workspace payment \
    && npm run build --workspace discounts \
    && npm run build --workspace business \
    && npm run build --workspace waitlist \
    && npm run build --workspace client

RUN npm prune --omit=dev --workspaces --include-workspace-root

FROM node:22.13.1-slim AS runtime
WORKDIR /usr/src/app
ENV NODE_ENV=production

COPY --from=build /usr/src/app/package*.json ./
COPY --from=build /usr/src/app/node_modules ./node_modules

COPY --from=build /usr/src/app/libs/messaging/package.json ./libs/messaging/package.json
COPY --from=build /usr/src/app/libs/messaging/dist ./libs/messaging/dist

COPY --from=build /usr/src/app/packages/public-flows/package.json ./packages/public-flows/package.json
COPY --from=build /usr/src/app/packages/public-flows/dist ./packages/public-flows/dist

COPY --from=build /usr/src/app/services/translation/translation-connector/package.json ./services/translation/translation-connector/package.json
COPY --from=build /usr/src/app/services/translation/translation-connector/dist ./services/translation/translation-connector/dist

COPY --from=build /usr/src/app/services/lexicon/package.json ./services/lexicon/package.json
COPY --from=build /usr/src/app/services/lexicon/dist ./services/lexicon/dist
COPY --from=build /usr/src/app/services/lexicon/entrypoint.sh ./services/lexicon/entrypoint.sh

COPY --from=build /usr/src/app/services/phrasebook/package.json ./services/phrasebook/package.json
COPY --from=build /usr/src/app/services/phrasebook/dist ./services/phrasebook/dist
COPY --from=build /usr/src/app/services/phrasebook/entrypoint.sh ./services/phrasebook/entrypoint.sh

COPY --from=build /usr/src/app/services/flashcards/package.json ./services/flashcards/package.json
COPY --from=build /usr/src/app/services/flashcards/dist ./services/flashcards/dist
COPY --from=build /usr/src/app/services/flashcards/entrypoint.sh ./services/flashcards/entrypoint.sh

COPY --from=build /usr/src/app/services/focus/package.json ./services/focus/package.json
COPY --from=build /usr/src/app/services/focus/dist ./services/focus/dist

COPY --from=build /usr/src/app/services/practice/package.json ./services/practice/package.json
COPY --from=build /usr/src/app/services/practice/dist ./services/practice/dist
COPY --from=build /usr/src/app/services/practice/entrypoint.sh ./services/practice/entrypoint.sh

COPY --from=build /usr/src/app/services/courses/package.json ./services/courses/package.json
COPY --from=build /usr/src/app/services/courses/dist ./services/courses/dist
COPY --from=build /usr/src/app/services/courses/entrypoint.sh ./services/courses/entrypoint.sh
COPY --from=build /usr/src/app/services/courses/src/content ./services/courses/src/content

COPY --from=build /usr/src/app/services/challenges/package.json ./services/challenges/package.json
COPY --from=build /usr/src/app/services/challenges/dist ./services/challenges/dist

COPY --from=build /usr/src/app/services/payment/package.json ./services/payment/package.json
COPY --from=build /usr/src/app/services/payment/dist ./services/payment/dist

COPY --from=build /usr/src/app/services/discounts/package.json ./services/discounts/package.json
COPY --from=build /usr/src/app/services/discounts/dist ./services/discounts/dist

COPY --from=build /usr/src/app/services/business/package.json ./services/business/package.json
COPY --from=build /usr/src/app/services/business/dist ./services/business/dist

COPY --from=build /usr/src/app/services/waitlist/package.json ./services/waitlist/package.json
COPY --from=build /usr/src/app/services/waitlist/dist ./services/waitlist/dist

COPY --from=build /usr/src/app/services/client/package.json ./services/client/package.json
COPY --from=build /usr/src/app/services/client/dist ./services/client/dist
COPY --from=build /usr/src/app/services/client/node_modules ./services/client/node_modules
COPY --from=build /usr/src/app/services/client/public ./services/client/public

RUN chmod +x /usr/src/app/services/lexicon/entrypoint.sh \
    && chmod +x /usr/src/app/services/phrasebook/entrypoint.sh \
    && chmod +x /usr/src/app/services/flashcards/entrypoint.sh \
    && chmod +x /usr/src/app/services/practice/entrypoint.sh \
    && chmod +x /usr/src/app/services/courses/entrypoint.sh
