# Copy this file to /opt/misneach/env/web.env and set real values
# Do not commit real secrets
# `CLIENT_API_URL` is the single API entrypoint used by web survey/waitlist routes.
# Set values based on runtime:
# - local host dev: http://localhost:8000
# - local docker dev: http://client:8000
# - production: https://api.your-domain.tld
# `NEST_INTERNAL_URL` is optional fallback and can be set equal to `CLIENT_API_URL`.

WEB_APP_URL=
APP_BASE_URL=
CLIENT_API_URL=
NEST_INTERNAL_URL=
